{
  "name": "portfolio-v2",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:stats": "ng build --configuration=production --stats-json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "optimize-images": "node optimize-images-advanced.js",
    "compress": "node compress-assets.js",
    "optimize:css": "npm run build:prod",
    "optimize:all": "npm run build:prod && npm run compress",
    "server:dev": "ng serve",
    "server:prod": "npm run build:prod && node server.js",
    "server:simple": "npx http-server dist/portfolio-v2/browser -p 8080 --gzip --cors",
    "server:optimized": "npm run optimize:all && npm run server:simple",
    "analyze": "npm run build:stats && npx webpack-bundle-analyzer dist/portfolio-v2/browser/stats.json",
    "analyze:source": "npm run build:stats && npx source-map-explorer dist/portfolio-v2/browser/*.js --html bundle-report.html",
    "test:lighthouse:local": "lhci autorun --collect.url=http://localhost:4200",
    "test:lighthouse:prod": "lhci autorun --collect.url=http://localhost:8080",
    "perf:full": "npm run optimize:all && npm run server:simple",
    "perf:analyze": "npm run analyze && npm run server:simple",
    "perf:ultimate": "npm run optimize:all && npm run server:simple && npm run test:lighthouse:prod",
    "optimize:images": "node optimize-images-ultra.js",
    "server:express": "node server-express.js",
    "server:ultra": "npm run optimize:all && npm run optimize:images && npm run server:express",
    "debug:performance": "npm run build:stats && npm run analyze:source",
    "clean:dist": "rmdir /s /q dist 2>nul || true",
    "fresh:build": "npm run clean:dist && npm run optimize:all"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "bootstrap": "^5.3.5",
    "ngx-bootstrap": "^19.0.2",
    "ngx-highlightjs": "^14.0.0",
    "rxjs": "~7.8.0",
    "three": "^0.175.0",
    "three-stdlib": "^2.36.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.7",
    "@angular/cli": "^19.2.7",
    "@angular/compiler-cli": "^19.2.0",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@types/bootstrap": "^5.2.10",
    "@types/jasmine": "~5.1.0",
    "@types/three": "^0.175.0",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "glob": "^11.0.3",
    "http-server": "^14.1.1",
    "imagemin": "^9.0.1",
    "imagemin-avif": "^0.1.6",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-webp": "^8.0.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sharp": "^0.34.3",
    "typescript": "~5.7.2"
  }
}
